# Model pentru ML2/.env (copiază-l în .env și completează; .env NU se urcă pe git, repo-ul e public)
# Folosit de emergency_notify.py: la call_112 anunță persoana de contact de aici (NU 112).

# Telegram (CallMeBot): username-ul colegului; el trebuie să fi dat /start la @CallMeBot_txtbot
VIGIL_NOTIFY_TELEGRAM=@username_coleg

# Apel de pe telefonul tău Android legat prin USB (depanare USB pornită). Gol = fără apel.
VIGIL_CALL_PHONE=
VIGIL_ADB=C:\platform-tools\adb.exe
